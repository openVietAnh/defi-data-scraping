# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# The Graph API key — obtain from https://thegraph.com/studio/apikeys/
API_KEY=your_graph_api_key_here

# Alchemy node URL — obtain from https://dashboard.alchemy.com/
ALCHEMY_URL=https://eth-mainnet.alchemyapi.io/v2/your_alchemy_key_here
